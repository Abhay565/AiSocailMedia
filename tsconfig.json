{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "jsx": "react-native",
    "allowJs": true,
    "esModuleInterop": true,
    "strict": true,
    "moduleResolution": "node",
    "skipLibCheck": true,
    "types": ["expo", "react", "react-native"]
  },
  "exclude": ["node_modules", "babel.config.js"]
}
